{
  "name": "automation-watchdog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "worker": "tsx --env-file=.env.local src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --maxWorkers=1",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs commit",
    "verify:push": "node scripts/verify.mjs push",
    "stack:start": "node scripts/supabase-stack.mjs start",
    "stack:stop": "node scripts/supabase-stack.mjs stop",
    "db:reset": "supabase db reset",
    "provision-workspace": "tsx --env-file=.env.local scripts/provision-workspace.ts",
    "delete-workspace": "tsx --env-file=.env.local scripts/delete-workspace.ts",
    "configure-google": "tsx --env-file=.env.local scripts/configure-google.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "format": "prettier --write src scripts tests *.ts *.mjs",
    "format:check": "prettier --check src scripts tests *.ts *.mjs",
    "test:n8n": "tsx --env-file=.env.local scripts/test-n8n.ts",
    "test:workflows": "tsx --env-file=.env.local scripts/test-workflows.ts",
    "local:start": "node scripts/local-stack.mjs start",
    "local:stop": "node scripts/local-stack.mjs stop",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.2",
    "next": "^16.4.3",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
